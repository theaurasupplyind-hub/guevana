{
  "expo": {
    "name": "DHUB",
    "slug": "dhub",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dhub",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "com.dhub.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bdc27b99-b312-4a51-8aff-47ee596d08cb"
      }
    },
    "owner": "jesus500"
  }
}
