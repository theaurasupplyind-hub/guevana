{
  "name": "dhub",
  "private": true,
  "version": "0.0.1",
  "description": "Hub personal de peliculas",
  "author": "Jesus",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5177 && set VITE_DEV=1&& electron .",
    "build": "vite build",
    "build:app": "set VITE_EMBEDDED=1&& vite build",
    "preview": "vite preview",
    "dist": "npm run build:app && electron-builder --win",
    "dist:portable": "npm run build:app && electron-builder --win portable"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "hls.js": "^1.5.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vite": "^5.4.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.dhub.app",
    "productName": "DHUB",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "!electron/run-server.cjs",
      "!electron/test-server.cjs"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
